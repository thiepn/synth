{
  "name": "Synth",
  "short_name": "Synth",
  "description": "A local-first generative beat workstation.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#080907",
  "theme_color": "#080907",
