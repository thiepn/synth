{
  "name": "synth",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-pwa-icons.mjs && node scripts/fetch-cc0-samples.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-pwa-icons.mjs && node scripts/fetch-cc0-samples.mjs",
    "build": "npm run check:interaction && npm run check:playground && npm run check:sound && npm run check:mix && npm run check:finish && npm run check:feel && npm run check:variation && npm run check:jam && npm run check:starter && npm run check:song-drafts && npm run check:performance && npm run check:architecture && npm run check:release && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:interaction": "node scripts/check-interaction-contracts.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "postbuild": "npm run check:bundle",
    "check:performance": "node scripts/check-performance-contracts.mjs",
    "check:architecture": "node scripts/check-architecture-contracts.mjs",
    "qa:e2e": "playwright test e2e/production.spec.ts --repeat-each=2 --retries=0",
    "qa:e2e:install": "playwright install --with-deps chromium",
    "check:release": "node scripts/check-release-freeze.mjs",
    "qa:soak": "playwright test e2e/soak.spec.ts --repeat-each=2 --retries=0",
    "check:playground": "node scripts/check-playground-release.mjs",
    "qa:playground": "playwright test e2e/playground.spec.ts --repeat-each=2 --retries=0",
    "check:sound": "node scripts/check-sound-quality.mjs",
    "check:mix": "node scripts/check-playground-mix.mjs",
    "check:finish": "node scripts/check-playground-finish.mjs",
    "check:feel": "node scripts/check-playground-feel.mjs",
    "check:variation": "node scripts/check-playground-variation.mjs",
    "check:jam": "node scripts/check-playground-jam.mjs",
    "check:recovery": "node scripts/check-playground-recovery.mjs",
    "check:starter": "node scripts/check-playground-starters.mjs",
    "check:song-drafts": "node scripts/check-playground-song-drafts.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "@playwright/test": "1.63.0"
  }
}
