{
  "name": "synth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-pwa-icons.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-pwa-icons.mjs",
    "build": "npm run check:interaction && npm run check:performance && tsc --noEmit && vite build",
