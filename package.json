{
  "name": "synth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-pwa-icons.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-pwa-icons.mjs",
    "build": "npm run check:interaction && npm run check:performance && npm run check:architecture && npm run check:release && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:interaction": "node scripts/check-interaction-contracts.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "postbuild": "npm run check:bundle",
    "check:performance": "node scripts/check-performance-contracts.mjs",
    "check:architecture": "node scripts/check-architecture-contracts.mjs",
    "qa:e2e": "playwright test e2e/production.spec.ts --repeat-each=2 --retries=0",
    "qa:e2e:install": "playwright install --with-deps chromium",
    "check:release": "node scripts/check-release-freeze.mjs",
    "qa:soak": "playwright test e2e/soak.spec.ts --repeat-each=2 --retries=0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "@playwright/test": "1.63.0"
  }
}
